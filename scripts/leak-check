#!/usr/bin/env python3
"""Report git-tracked lines matching scripts/leak-patterns (one regex per line).

Exits 0 in report mode; with LEAK_CHECK_ENFORCE=1, exits 1 on any hit.
"""
import os
import re
import subprocess
import sys
from pathlib import Path

root = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
patterns_file = "scripts/leak-patterns"
patterns = [(p, re.compile(p)) for p in (root / patterns_file).read_text().splitlines() if p]
files = subprocess.check_output(["git", "ls-files", "-z"], cwd=root, text=True).split("\0")

hits = 0
for path in files:
    if not path or path in (patterns_file, "LICENSE"):
        continue
    try:
        lines = (root / path).read_text(encoding="utf-8").splitlines()
    except (UnicodeDecodeError, IsADirectoryError, FileNotFoundError):
        continue
    for n, line in enumerate(lines, 1):
        for raw, rx in patterns:
            if rx.search(line):
                print(f"{path}:{n}: {raw}")
                hits += 1

print(f"leak-check: {hits} hits")
sys.exit(1 if hits and os.environ.get("LEAK_CHECK_ENFORCE") == "1" else 0)
